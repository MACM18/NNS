{
  "expo": {
    "name": "NNS Enterprise",
    "slug": "nns-enterprise-mobile",
    "scheme": "nnsenterprise",
    "version": "1.1.5",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "lk.nns.enterprise.mobile",
      "versionCode": 8,
      "allowBackup": false,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#F2F9FD",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NNS Enterprise to scan a sign-in QR code.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "83a22313-ccf3-41d1-b056-38aa744fb54d"
      }
    },
    "owner": "macmlk"
  }
}
