{
  "expo": {
    "name": "NNS Enterprise",
    "slug": "nns-enterprise-mobile",
    "scheme": "nnsenterprise",
    "version": "1.1.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "lk.nns.enterprise.mobile",
      "versionCode": 3,
      "allowBackup": false,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#123E5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-web-browser",
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "83a22313-ccf3-41d1-b056-38aa744fb54d"
      }
    },
    "owner": "macmlk"
  }
}
