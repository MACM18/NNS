# Public NNS Enterprise web/API origin, without a trailing slash.
EXPO_PUBLIC_NNS_API_URL=https://your-nns-domain.example

# OAuth client IDs from Google Cloud Console. The Android client must match
# lk.nns.enterprise.mobile and the signing certificate used by the APK.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
