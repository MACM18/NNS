# Profile image storage (S3-compatible, server only)
CUSTOMER_DATA_ENCRYPTION_KEY=
# Required for encrypting customer and line data in PostgreSQL. Generate once with:
# openssl rand -base64 48
# Keep this value stable and back it up securely. Never commit a real key.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for providers such as MinIO or Cloudflare R2
S3_ENDPOINT=
# Public CDN or bucket base URL used to display avatars
S3_PUBLIC_BASE_URL=
S3_AVATAR_PREFIX=avatars/

# Browser push notifications (generate a key pair with `npx web-push generate-vapid-keys --json`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real support email address or the public app URL as the VAPID subject.
VAPID_SUBJECT=mailto:admin@macm.lk

# Authenticated health endpoint (set a long random value in production)
HEALTH_CHECK_TOKEN=
